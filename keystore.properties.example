# Copy to keystore.properties (git-ignored) and fill in real values.
# Credentials can alternatively come from env vars:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD, AI_PROXY_URL, NISAB_RATE_URL.
storeFile=keystore/sakinah_release.jks
storePassword=change_me
keyAlias=sakinah_key
keyPassword=change_me

# Generate the keystore with:
# keytool -genkeypair -v -keystore keystore/sakinah_release.jks -alias sakinah_key \
#   -keyalg RSA -keysize 4096 -validity 10000 -storetype JKS

# Server-side AI proxy for the Sunni Scholar (the raw Gemini key stays on the server).
AI_PROXY_URL=https://your-backend.example.com/api/scholar

# Optional public metal-price endpoint used for live nisab rates.
# Empty uses the last cached rate.
NISAB_RATE_URL=https://your-backend.example.com/api/nisab

