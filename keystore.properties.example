# Copy to keystore.properties (git-ignored) and fill in real values.
# Credentials can alternatively come from env vars:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD, GEMINI_API_KEY.
storeFile=../keystore/sakinah_release.jks
storePassword=change_me
keyAlias=sakinah_key
keyPassword=change_me

# Generate the keystore with:
# keytool -genkeypair -v -keystore ../keystore/sakinah_release.jks -alias sakinah_key \
#   -keyalg RSA -keysize 4096 -validity 10000 -storetype JKS

GEMINI_API_KEY=MY_GEMINI_API_KEY
