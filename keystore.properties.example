# Copy to keystore.properties (git-ignored) and fill in real values.
# Credentials can alternatively come from env vars; when both are set the env vars win:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD, AI_PROXY_URL, NISAB_RATE_URL.
# In CI write this file next to the Gradle root before assembleRelease/bundleRelease, or
# export the variables instead; either satisfies the release signing check.
storeFile=keystore/sakinah_deen_aqmirza.jks
storePassword=sakinah_deen_aqmirza
keyAlias=sakinah_deen_aqmirza
keyPassword=sakinah_deen_aqmirza

# Generate the keystore with:
# keytool -genkeypair -v -keystore keystore/sakinah_deen_aqmirza.jks -alias sakinah_deen_aqmirza \
#   -storepass sakinah_deen_aqmirza -keypass sakinah_deen_aqmirza \
#   -keyalg RSA -keysize 4096 -validity 10000 -storetype JKS

# Server-side AI proxy for the Islamic Scholar (the raw Gemini key stays on the server).
AI_PROXY_URL=https://your-backend.example.com/api/scholar

# Optional public metal-price endpoint used for live nisab rates.
# Empty uses the last cached rate.
NISAB_RATE_URL=https://your-backend.example.com/api/nisab

