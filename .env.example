# Sakinah mobile (Android + iOS via Kotlin Multiplatform)
#
# Secrets are never embedded in the mobile binaries. The AI companion calls a
# backend proxy whose URL is configured here for local development.
SAKINAH_AI_PROXY_URL="https://your-backend.example.com/api/scholar"

# Optional: override the default KMP build cache location.
# GRADLE_USER_HOME=/path/to/gradle
