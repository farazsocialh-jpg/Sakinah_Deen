# Sakinah mobile (Android + iOS via Kotlin Multiplatform)
#
# No provider secret is ever embedded in the mobile binaries. The AI companion calls a
# backend proxy whose URL is configured here; the model credential stays on the server.

# Optional POST endpoint for the AI Scholar. With this blank the app uses its
# built-in grounded offline answers and citations instead of calling out.
AI_PROXY_URL="https://your-backend.example.com/api/scholar"

# GET endpoint for live nisab rates. Expected response:
#   { "goldPerGram": 88.4, "silverPerGram": 1.15, "date": "2026-11-12" }
# (numeric `gold`/`silver` and `updatedAt` seconds/millis are also accepted).
# With this blank the app keeps the last cached rate, or a built-in estimate.
NISAB_RATE_URL="https://your-backend.example.com/api/nisab"

# Optional: override the default KMP build cache location.
# GRADLE_USER_HOME=/path/to/gradle
