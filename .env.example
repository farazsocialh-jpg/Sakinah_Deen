# ImanCore mobile (Android + iOS via Kotlin Multiplatform)
#
# No provider secret is ever embedded in the mobile binaries. The AI companion calls a
# backend proxy whose URL is configured here; the model credential stays on the server.

# AI Scholar proxy (the Cloudflare Worker in worker/). Required for the AI Scholar screen:
# there is no built-in default, so a blank value leaves the screen in its "not configured"
# state rather than contacting a deployment this build did not choose.
AI_PROXY_URL=""

# GET endpoint for live nisab rates. Expected response:
#   { "goldPerGram": 88.4, "silverPerGram": 1.15, "date": "2026-11-12" }
# (numeric `gold`/`silver` and `updatedAt` seconds/millis are also accepted).
# With this blank the app keeps the last cached rate, or a built-in estimate.
NISAB_RATE_URL="https://your-backend.example.com/api/nisab"

# Web OAuth client id for Credential Manager Google Sign-In (serverClientId).
# Create an Android OAuth client (package com.imancore.app + signing SHA-1) and a Web
# OAuth client in Google Cloud Console; this is the Web client's id. See
# docs/release-signing.md section 6. Blank builds still work and show an inline message.
GOOGLE_WEB_CLIENT_ID=""

# Optional: override the default KMP build cache location.
# GRADLE_USER_HOME=/path/to/gradle
