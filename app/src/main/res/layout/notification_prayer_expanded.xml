<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded prayer reminder.
  The progress bar is pulsed at fire time with the remaining share of the prayer
  window; the reminder text rotates daily per prayer. Root stays transparent so
  the system notification surface shows edge-to-edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/notif_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF111111"
        android:text="@string/notif_prayer_fallback_title" />

    <TextView
        android:id="@+id/notif_expanded_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#FF5F6B66"
        android:text="@string/notif_prayer_fallback_window" />

    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/notif_progress_bar"
        android:progressTint="@color/notif_progress_tint"
        android:progressBackgroundTint="@color/notif_progress_track" />

    <TextView
        android:id="@+id/notif_reminder_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textDirection="anyRtl"
        android:textSize="14sp"
        android:textColor="#FF111111" />

    <TextView
        android:id="@+id/notif_reminder_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textSize="12sp"
        android:textColor="#FF48524D" />

    <TextView
        android:id="@+id/notif_reminder_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textStyle="italic"
        android:textSize="10sp"
        android:textColor="#FF6B7571" />
</LinearLayout>