<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed prayer reminder (Option 1 - clean countdown).
  Rendered inside NotificationCompat.DecoratedCustomViewStyle so the native header
  keeps the app icon/label and live countdown. Colours are applied at build time
  from the active Sakinah palette; the defaults below only matter pre-inflation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF111111"
            android:text="@string/notif_prayer_fallback_title" />

        <Chronometer
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:countDown="true"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF111111" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_collapsed_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="#FF5F6B66"
            android:text="@string/notif_prayer_fallback_window" />

        <TextView
            android:id="@+id/notif_action_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF14624A"
            android:text="@string/adhan_action_mute" />

        <TextView
            android:id="@+id/notif_action_prayed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FF14624A"
            android:text="@string/notif_action_mark_prayed" />
    </LinearLayout>
</LinearLayout>
