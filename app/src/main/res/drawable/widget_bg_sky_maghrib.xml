<?xml version="1.0" encoding="utf-8"?>
<!-- Living Sky · Maghrib: violet sunset fading to dusk. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#7B4A9C"
        android:centerColor="#4C2A6A"
        android:startColor="#331A4A"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
