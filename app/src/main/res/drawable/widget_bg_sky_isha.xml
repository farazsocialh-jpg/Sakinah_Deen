<?xml version="1.0" encoding="utf-8"?>
<!-- Living Sky · Isha: night indigo with a cold starlit lift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#2A3568"
        android:centerColor="#131B3A"
        android:startColor="#080D22"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
