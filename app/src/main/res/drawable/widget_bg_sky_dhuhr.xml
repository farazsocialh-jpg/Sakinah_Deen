<?xml version="1.0" encoding="utf-8"?>
<!-- Living Sky · Dhuhr: high blue noon sky. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#3E9BCB"
        android:centerColor="#1D6FA5"
        android:startColor="#14608F"
        android:type="linear" />
    <corners android:radius="24dp" />
