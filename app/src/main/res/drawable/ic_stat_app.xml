<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the Sakinah crescent-and-star silhouette.

  Status-bar icons must be a flat, single-colour alpha mask on a transparent
  background. Without this the platform draws the full-colour launcher icon as a
  solid white square. Everything here is pure white (#FFFFFFFF); Android tints
  the alpha channel to match the system status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Crescent: outer disc minus an offset disc (even-odd fill). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M11,2.6a9.4,9.4 0 1,0 0,18.8a9.4,9.4 0 1,0 0,-18.8zM16.1,3.9a8.1,8.1 0 1,0 0,16.2a8.1,8.1 0 1,0 0,-16.2z" />

    <!-- Four-point star inside the crescent's opening. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18.6,8.1L20.0,10.7L22.6,12.1L20.0,13.5L18.6,16.1L17.2,13.5L14.6,12.1L17.2,10.7z" />
</vector>
