<?xml version="1.0" encoding="utf-8"?>
<!-- Rub el Hizb (8-pointed Islamic star) with a crescent, kept inside the
     66dp adaptive-icon safe zone (18..90 of the 108dp viewport). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lower square of the 8-point star -->
    <path
        android:pathData="M54,30 L78,54 L54,78 L30,54 Z"
        android:fillColor="#10B981"
        android:fillAlpha="0.18"
        android:strokeColor="#FBBF24"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round" />

    <!-- Upper square, rotated 45 degrees -->
    <path
        android:pathData="M30,54 L54,30 L78,54 L54,78 Z"
        android:fillColor="#00000000"
        android:strokeColor="#10B981"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round" />

    <!-- Crescent opening to the right -->
    <path
        android:pathData="M60,36 A18,18 0 1,0 60,72 A14,14 0 1,1 60,36 Z"
        android:fillColor="#FBBF24"
        android:fillAlpha="0.95" />

    <!-- Small five-point star at the crescent's opening -->
    <path
        android:pathData="M66,50 L68.2,55.8 L74.4,56.1 L69.6,60 L71.3,66 L66,62.6 L60.7,66 L62.4,60 L57.6,56.1 L63.8,55.8 Z"
        android:fillColor="#FBBF24"
        android:fillAlpha="0.9" />
</vector>
