<?xml version="1.0" encoding="utf-8"?>
<!-- Living Sky · Fajr: pre-dawn navy lifting into first light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#4A6FA5"
        android:centerColor="#2B4C7E"
        android:startColor="#1E3A63"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
