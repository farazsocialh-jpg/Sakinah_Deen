<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Sakinah" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sakinah_emerald_deep</item>
        <item name="android:statusBarColor">@color/sakinah_emerald_deep</item>
        <item name="android:navigationBarColor">@color/sakinah_emerald_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- AndroidX SplashScreen: emerald background, centred geometric emblem. -->
    <style name="Theme.Sakinah.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sakinah_emerald_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Sakinah</item>
    </style>
</resources>
