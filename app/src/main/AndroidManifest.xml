<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Remote API Access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location & Astronomical Qibla/Prayer Times -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth & In-Vehicle Handshake -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Alarms, Doze-Bypass & Reboot Restoration -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Prayer reminders are notification-type alerts: no full-screen intents, no alarm stream. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required for the vibrate-only Salah alert channel and for cancelling its pattern. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 14/15/16 Foreground Service Types -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Compass & accelerometer are optional: do not exclude tablets/foldables/budget handsets -->
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SakinahApp"
        android:taskAffinity=""
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sakinah">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sakinah.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- An activity-level android:permission gates the *caller*, so requiring
             BLUETOOTH_CONNECT made the launcher (which does not hold it) unable to open the
             configuration screen. The activity validates its appWidgetId and writes only that
             widget's own preferences, so no caller permission is needed. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.Sakinah">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".service.SakinahFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sakinah_fcm_notifications" />

        <!-- Adhan Audio Playback Foreground Service (Media3 / ExoPlayer) -->
        <service
            android:name=".service.AdhanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Prayer Alarm Receiver: fires the Adhan, scheduling handled elsewhere -->
        <receiver
            android:name=".service.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sakinah.deen.ACTION_PRAYER_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Prayer card actions: Mute, swipe dismissal and Mark as Prayed -->
        <receiver
            android:name=".service.PrayerNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sakinah.deen.ACTION_MUTE_ADHAN" />
                <action android:name="com.sakinah.deen.ACTION_DISMISS_PRAYER" />
                <action android:name="com.sakinah.deen.ACTION_MARK_PRAYED" />
            </intent-filter>
        </receiver>

        <!-- ImanCore Glance widget suite -->
        <!-- Today’s Salah Tracker -->
        <receiver
            android:name=".widget.SalahTrackerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_salah_tracker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/salah_tracker_widget_info" />
        </receiver>

        <!-- Tasbih Counter -->
        <receiver
            android:name=".widget.TasbihWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tasbih_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasbih_widget_info" />
        </receiver>

        <!-- Ayah of the Day -->
        <receiver
            android:name=".widget.DailyAyahWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_daily_ayah_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_ayah_widget_info" />
        </receiver>

        <!-- Ask ImanCore Scholar -->
        <receiver
            android:name=".widget.AiScholarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ai_scholar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ai_scholar_widget_info" />
        </receiver>

        <!-- Hijri Date -->
        <receiver
            android:name=".widget.HijriDateWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_hijri_date_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hijri_date_widget_info" />
        </receiver>

        <!-- Qibla Direction -->
        <receiver
            android:name=".widget.QiblaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_qibla_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLE" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qibla_widget_info" />
        </receiver>


        <!-- Boot / clock / timezone restoration of exact alarms -->
        <receiver
            android:name=".service.BootAndAlarmReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialized on demand by SakinahApp via Configuration.Provider,
             so the default androidx.startup initializer must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- In-Car Bluetooth Handshake Receiver -->
        <receiver
            android:name=".receiver.CarBluetoothReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
